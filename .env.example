# Sao chép thành .env (hoặc chạy ./ops/init.sh để tự sinh mật khẩu).
# KHÔNG commit file .env

# ---- Database / Redis ----
DB_ROOT_PASSWORD=doi-mat-khau-root
DB_USER=mc
DB_PASSWORD=doi-mat-khau-db
REDIS_PASSWORD=doi-mat-khau-redis

# ---- Velocity modern forwarding ----
# Secret dùng chung giữa proxy và mọi server con. Đổi thành chuỗi ngẫu nhiên dài.
VELOCITY_SECRET=doi-secret-velocity

# ---- Phiên bản ----
# Phiên bản Minecraft cho lobby và các chế độ Paper.
# LATEST = bản mới nhất Paper hỗ trợ (Geyser luôn theo bản Java mới nhất).
# Sau khi chạy ổn, nên ghim cụ thể (ví dụ 1.21.x) để tránh tự nâng cấp ngoài ý muốn.
MC_VERSION=LATEST

# Phiên bản cho chế độ Pokémon: phải đúng phiên bản Cobblemon hỗ trợ (xem trang Cobblemon trên Modrinth).
POKEMON_MC_VERSION=1.21.1

# ---- Link tải plugin không có trên trang tải tự động ----
# Đổi nếu link mặc định lỗi (xem trang releases trên GitHub để lấy đúng tên file).
LIBRELOGIN_URL=https://github.com/kyngs/LibreLogin/releases/latest/download/LibreLogin.jar
NANOLIMBO_URL=https://github.com/Nan1t/NanoLimbo/releases/latest/download/NanoLimbo.jar

# ---- Cổng mở ra ngoài (trên máy chạy Docker) ----
JAVA_PORT=25565
BEDROCK_PORT=19132
