# Sao chép thành .env (hoặc chạy ./ops/init.sh để tự sinh mật khẩu).
# KHÔNG commit file .env

# ---- Database / Redis ----
DB_ROOT_PASSWORD=doi-mat-khau-root
DB_USER=mc
DB_PASSWORD=doi-mat-khau-db
REDIS_PASSWORD=doi-mat-khau-redis

# ---- Velocity modern forwarding ----
# Secret dùng chung giữa proxy và mọi server con. Đổi thành chuỗi ngẫu nhiên dài.
VELOCITY_SECRET=doi-secret-velocity

# ---- AuthMe (đăng nhập cho offline mode) ----
# Secret ký tin nhắn giữa AuthMe trên proxy và trên lobby. Đổi thành chuỗi ngẫu nhiên dài.
AUTHME_SECRET=doi-secret-authme

# ---- RCON (điều khiển server từ xa, dùng nội bộ: sao lưu, trang Cài đặt) ----
RCON_PASSWORD=doi-mat-khau-rcon

# ---- Sao lưu tự động ----
# Thư mục lưu bản sao lưu. Bỏ trống = backups/ trong repo (ổ C). Nếu đặt thì phải là đường dẫn tuyệt đối,
# ví dụ ổ F trên Windows: /mnt/f/DuckyMoMo-backups
BACKUP_DIR=
BACKUP_INTERVAL=6h
BACKUP_KEEP_DAYS=7
# Mật khẩu kho sao lưu restic (world các server). MẤT LÀ KHÔNG KHÔI PHỤC ĐƯỢC: cất thêm một bản ngoài máy.
RESTIC_PASSWORD=doi-mat-khau-restic

# ---- Trang Cài đặt (http://localhost:8889) ----
PANEL_USER=admin
PANEL_PASSWORD=doi-mat-khau-panel

# ---- playit.gg (chỉ cần khi chạy --profile tunnel) ----
# Lấy ở playit.gg: Add agent > Docker, copy giá trị SECRET_KEY.
PLAYIT_SECRET_KEY=

# ---- Phiên bản ----
# Phiên bản Minecraft cho lobby và các chế độ Paper.
# LATEST = bản mới nhất Paper hỗ trợ (Geyser luôn theo bản Java mới nhất).
# Sau khi chạy ổn, nên ghim cụ thể (ví dụ 1.21.x) để tránh tự nâng cấp ngoài ý muốn.
# Ghim phiên bản: LATEST làm server tự nâng khi có bản mới (12/10/2026 lobby tự lên 26.3, WorldEdit 7.4.5 sập).
# Nâng phiên bản: kiểm tra plugin (WorldEdit, WorldGuard, AuthMe…) hỗ trợ trước, sao lưu, rồi mới đổi số ở đây.
MC_VERSION=26.2

# Phiên bản cho chế độ Pokémon: phải đúng phiên bản Cobblemon hỗ trợ (xem trang Cobblemon trên Modrinth).
POKEMON_MC_VERSION=1.21.1

# ---- Cổng mở ra ngoài (trên máy chạy Docker) ----
JAVA_PORT=25565
BEDROCK_PORT=19132

# ---- Bản đồ web squaremap của Bang Hội Chiến (chỉ mở trong máy; xem qua Trạm 6 /mc/map) ----
SQUAREMAP_PORT=8890

# ---- Discord (DiscordSRV ở Bang Hội Chiến): chat trong game <-> kênh Discord, báo công thành ----
# Tạo bot: discord.com/developers/applications > New Application > Bot > Reset Token (bật MESSAGE CONTENT INTENT,
# SERVER MEMBERS INTENT), mời bot vào server Discord. ID kênh: bật Developer Mode, chuột phải kênh > Copy Channel ID.
# Để trống thì DiscordSRV tự tắt.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_SIEGE_WEBHOOK_URL=

# ---- Gói font tiếng Việt cho người chơi (ops/build-font-pack.sh tự ghi 2 dòng này) ----
FONT_PACK_URL=
FONT_PACK_SHA1=
